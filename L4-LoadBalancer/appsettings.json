{
  "HealthCheck": {
    "IntervalSeconds": 2,
    "FailureThreshold": 3
  },
  "LoadBalancing": {
    "Strategy": "RoundRobin"
  },
  "Listener": {
    "Address": "0.0.0.0",
    "Port": 9000
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/l4-loadbalancer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }

}

